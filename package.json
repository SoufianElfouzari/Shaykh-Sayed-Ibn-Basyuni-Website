{
  "name": "shaykh_sayed_landing_page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ssr": "node scripts/verify-ssr.mjs",
    "test:setup": "npm install --no-save --package-lock=false @playwright/test@1.65.0 @axe-core/playwright@4.14.0 @lhci/cli@0.16.0",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --import ./tests/fixtures/install-fetch.mjs --test tests/integration/*.test.mjs",
    "test:ssr:fixture": "node --import ./tests/fixtures/install-fetch.mjs scripts/verify-ssr.mjs",
    "test:e2e": "playwright test",
    "test:budget": "node scripts/check-bundle-budget.mjs",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "dompurify": "^3.4.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sanitize-html": "^2.18.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1"
  }
}
