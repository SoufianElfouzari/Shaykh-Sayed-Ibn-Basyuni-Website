{
  "functions": {
    "api/render.js": {
      "includeFiles": "{dist,dist-ssr}/**"
    },
    "api/sitemap.js": {
      "includeFiles": "dist-ssr/**"
    }
  },
  "routes": [
    {
      "src": "/duruus",
      "headers": {
        "Location": "/durous"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "dest": "/api/render?path=/"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/render?path=/$1"
    }
  ]
}
