{
  "routes": [
    {
      "src": "/duruus",
      "headers": {
        "Location": "/durous"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}